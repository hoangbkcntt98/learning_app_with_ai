generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  email        String         @id
  passwordHash String         @map("password_hash")
  name         String
  segment      String         @default("Free")
  avatarUrl    String?        @map("avatar_url")
  points       Int            @default(0)
  level        Int            @default(0)
  correctStreak Int           @default(0) @map("correct_streak")
  role         String
  aiDailyQuota Int?           @map("ai_daily_quota")
  createdAt    DateTime       @default(now()) @map("created_at")
  chatMessages ChatMessage[]
  chatExchanges ChatExchange[]
  chatPromptCaches ChatPromptCache[]
  dailyAiUsages DailyAiUsage[]
  forumPosts   ForumPost[]
  forumComments ForumComment[]
  questionLists UserQuestionList[]
  questionNotes UserQuestionNote[]
  questionFieldAccesses UserQuestionFieldAccess[]
  questionReports QuestionReport[]

  @@map("users")
}

model Question {
  id           Int      @id @default(autoincrement())
  questionFieldId Int   @default(1) @map("question_field_id")
  level        String
  prompt       String
  option1      String   @map("option_1")
  option2      String   @map("option_2")
  option3      String   @map("option_3")
  option4      String   @map("option_4")
  correctIndex Int      @map("correct_index")
  createdAt    DateTime @default(now()) @map("created_at")
  questionField QuestionField @relation(fields: [questionFieldId], references: [id], onDelete: Cascade)
  userLists    UserQuestionList[]
  userNotes    UserQuestionNote[]
  reports      QuestionReport[]

  @@map("questions")
}

model QuestionReport {
  id         BigInt   @id @default(autoincrement())
  userEmail  String   @map("user_email")
  questionId Int      @map("question_id")
  content    String
  createdAt  DateTime @default(now()) @map("created_at")
  user       User     @relation(fields: [userEmail], references: [email], onDelete: Cascade)
  question   Question @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@index([createdAt(sort: Desc)], map: "idx_question_reports_created_at")
  @@index([questionId], map: "idx_question_reports_question_id")
  @@index([userEmail], map: "idx_question_reports_user_email")
  @@map("question_reports")
}

model QuestionField {
  id        Int      @id @default(autoincrement())
  key       String   @unique
  name      String
  systemPrompt String @default("") @map("system_prompt")
  explanationPromptTemplate String @default("") @map("explanation_prompt_template")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  questions Question[]
  questionLevels QuestionLevel[]
  userAccesses UserQuestionFieldAccess[]

  @@map("question_fields")
}

model UserQuestionFieldAccess {
  userEmail       String @map("user_email")
  questionFieldId Int    @map("question_field_id")
  createdAt       DateTime @default(now()) @map("created_at")
  user            User   @relation(fields: [userEmail], references: [email], onDelete: Cascade)
  questionField   QuestionField @relation(fields: [questionFieldId], references: [id], onDelete: Cascade)

  @@id([userEmail, questionFieldId], map: "pk_user_question_field_access")
  @@index([questionFieldId], map: "idx_user_question_field_access_field_id")
  @@map("user_question_field_access")
}

model QuestionLevel {
  id              Int      @id @default(autoincrement())
  questionFieldId Int      @map("question_field_id")
  name            String
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")
  questionField   QuestionField @relation(fields: [questionFieldId], references: [id], onDelete: Cascade)

  @@unique([questionFieldId, name], map: "uq_question_level_field_name")
  @@index([questionFieldId], map: "idx_question_level_field_id")
  @@map("question_levels")
}

model ChatMessage {
  id        BigInt   @id @default(autoincrement())
  userEmail String   @map("user_email")
  exchangeId BigInt? @map("exchange_id")
  role      String
  content   String
  createdAt DateTime @default(now()) @map("created_at")
  user      User     @relation(fields: [userEmail], references: [email], onDelete: Cascade)
  exchange  ChatExchange? @relation(fields: [exchangeId], references: [id], onDelete: SetNull)

  @@index([userEmail, createdAt(sort: Desc)], map: "idx_chat_messages_user_created_at")
  @@index([exchangeId], map: "idx_chat_messages_exchange_id")
  @@map("chat_messages")
}

model ChatExchange {
  id            BigInt        @id @default(autoincrement())
  userEmail      String       @map("user_email")
  userText       String       @map("user_text")
  assistantText  String       @map("assistant_text")
  source         String       @default("ai_chat")
  language       String
  imageHash      String       @default("") @map("image_hash")
  createdAt      DateTime     @default(now()) @map("created_at")
  user           User         @relation(fields: [userEmail], references: [email], onDelete: Cascade)
  messages       ChatMessage[]

  @@index([userEmail, createdAt(sort: Desc)], map: "idx_chat_exchanges_user_created_at")
  @@map("chat_exchanges")
}

model ChatPromptCache {
  id            BigInt    @id @default(autoincrement())
  userEmail     String    @map("user_email")
  promptText    String    @map("prompt_text")
  language      String
  imageHash     String    @default("") @map("image_hash")
  assistantText String    @map("assistant_text")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")
  user          User      @relation(fields: [userEmail], references: [email], onDelete: Cascade)

  @@unique([promptText, language, imageHash], map: "uq_chat_prompt_cache_lookup")
  @@index([userEmail, updatedAt(sort: Desc)], map: "idx_chat_prompt_cache_user_updated_at")
  @@index([promptText, language, imageHash], map: "idx_chat_prompt_cache_lookup")
  @@map("chat_prompt_cache")
}

model ForumPost {
  id          BigInt        @id @default(autoincrement())
  userEmail   String        @map("user_email")
  subject     String        @default("Untitled")
  content     String
  imageBase64 String?       @map("image_base64")
  imageMimeType String?     @map("image_mime_type")
  createdAt   DateTime      @default(now()) @map("created_at")
  user        User          @relation(fields: [userEmail], references: [email], onDelete: Cascade)
  comments    ForumComment[]

  @@index([createdAt(sort: Desc)], map: "idx_forum_posts_created_at")
  @@map("forum_posts")
}

model ForumComment {
  id        BigInt    @id @default(autoincrement())
  postId    BigInt    @map("post_id")
  userEmail String    @map("user_email")
  content   String
  createdAt DateTime  @default(now()) @map("created_at")
  post      ForumPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userEmail], references: [email], onDelete: Cascade)

  @@index([postId, createdAt], map: "idx_forum_comments_post_created_at")
  @@map("forum_comments")
}

model AppConfig {
  id                   Int      @id
  aiDailyQuotaPerUser  Int      @default(20) @map("ai_daily_quota_per_user")
  maxRegisteredUsers   Int      @default(1000) @map("max_registered_users")
  aiChatAllowFree      Boolean  @default(false) @map("ai_chat_allow_free")
  aiChatAllowPlus      Boolean  @default(true) @map("ai_chat_allow_plus")
  aiChatAllowPro       Boolean  @default(true) @map("ai_chat_allow_pro")
  aiChatAllowPremium   Boolean  @default(true) @map("ai_chat_allow_premium")
  forumMinLevel        Int      @default(2) @map("forum_min_level")
  updatedAt            DateTime @updatedAt @map("updated_at")

  @@map("app_config")
}

model DailyAiUsage {
  id        BigInt   @id @default(autoincrement())
  userEmail String   @map("user_email")
  usageDate String   @map("usage_date")
  count     Int      @default(0)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  user      User     @relation(fields: [userEmail], references: [email], onDelete: Cascade)

  @@unique([userEmail, usageDate], map: "uq_daily_ai_usage_user_date")
  @@index([usageDate], map: "idx_daily_ai_usage_date")
  @@map("daily_ai_usage")
}

model UserQuestionList {
  id         BigInt   @id @default(autoincrement())
  userEmail  String   @map("user_email")
  questionId Int      @map("question_id")
  listType   String   @map("list_type")
  createdAt  DateTime @default(now()) @map("created_at")
  user       User     @relation(fields: [userEmail], references: [email], onDelete: Cascade)
  question   Question @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@unique([userEmail, questionId, listType], map: "uq_user_question_list_item")
  @@index([userEmail, listType, createdAt(sort: Desc)], map: "idx_user_question_list_lookup")
  @@map("user_question_list")
}

model UserQuestionNote {
  id         BigInt   @id @default(autoincrement())
  userEmail  String   @map("user_email")
  questionId Int      @map("question_id")
  note       String   @default("")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")
  user       User     @relation(fields: [userEmail], references: [email], onDelete: Cascade)
  question   Question @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@unique([userEmail, questionId], map: "uq_user_question_note")
  @@index([userEmail, updatedAt(sort: Desc)], map: "idx_user_question_note_lookup")
  @@map("user_question_notes")
}

model FeatureAccessRule {
  featureId      Int      @id @map("feature_id")
  featureKey     String   @unique @map("feature_key")
  featureName    String   @map("feature_name")
  routePath      String   @map("route_path")
  minLevel       Int      @default(0) @map("min_level")
  allowUser      Boolean  @default(true) @map("allow_user")
  allowAdmin     Boolean  @default(false) @map("allow_admin")
  allowFree      Boolean  @default(true) @map("allow_free")
  allowPlus      Boolean  @default(true) @map("allow_plus")
  allowPro       Boolean  @default(true) @map("allow_pro")
  allowPremium   Boolean  @default(true) @map("allow_premium")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  @@index([featureKey], map: "idx_feature_access_rule_key")
  @@map("feature_access_rules")
}
